# ══════════════════════════════════════════════════════════
# PORTAL EDITORIAL — Variables de Entorno
# ══════════════════════════════════════════════════════════
# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.

# ──────────────────────────────────────
# GENERAL
# ──────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=America/Caracas

# ──────────────────────────────────────
# BACKEND (Laravel)
# ──────────────────────────────────────
LARAVEL_APP_KEY=               # php artisan key:generate
LARAVEL_APP_URL=http://localhost:8000

# ──────────────────────────────────────
# BASE DE DATOS
# ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=portal_editorial
DB_USERNAME=portal_user
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ──────────────────────────────────────
# REDIS
# ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# ──────────────────────────────────────
# ALMACENAMIENTO DE ARCHIVOS
# ──────────────────────────────────────
# Opciones: local | s3 | r2
STORAGE_DRIVER=local

# Solo si STORAGE_DRIVER=r2 o s3:
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=              # Para R2: https://<account>.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=            # URL pública para servir archivos

# ──────────────────────────────────────
# FRONTEND PÚBLICO (Next.js)
# ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Contacto con la Noticia
NEXT_REVALIDATE_SECRET=        # token para invalidar ISR manualmente

# ──────────────────────────────────────
# PANEL ADMIN (Vite/React)
# ──────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_ADMIN_URL=http://localhost:5173

# ──────────────────────────────────────
# CORS (orígenes permitidos para la API)
# ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ──────────────────────────────────────
# AUTENTICACIÓN
# ──────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
SESSION_DRIVER=redis
SESSION_LIFETIME=120           # minutos

# ──────────────────────────────────────
# QUEUE (jobs para procesamiento de imágenes)
# ──────────────────────────────────────
QUEUE_CONNECTION=redis         # sync (dev sin Redis) | redis (producción)

# ──────────────────────────────────────
# PROCESAMIENTO DE IMÁGENES
# ──────────────────────────────────────
IMAGE_QUALITY_WEBP=80
IMAGE_QUALITY_AVIF=70
IMAGE_QUALITY_JPEG=85
IMAGE_MAX_UPLOAD_MB=20

# ──────────────────────────────────────
# MULTI-SITIO
# ──────────────────────────────────────
# El site_id se resuelve automáticamente por dominio.
# En desarrollo, se usa este valor por defecto:
DEFAULT_SITE_ID=1
DEFAULT_SITE_DOMAIN=localhost

# ──────────────────────────────────────
# PWA
# ──────────────────────────────────────
NEXT_PUBLIC_PWA_NAME=Contacto con la Noticia
NEXT_PUBLIC_PWA_SHORT_NAME=ContactoNoticia
NEXT_PUBLIC_PWA_THEME_COLOR=#1a1a2e

# ──────────────────────────────────────
# ANALYTICS (opcional, primera versión interna)
# ──────────────────────────────────────
ANALYTICS_ENABLED=true

# ──────────────────────────────────────
# CRM (integración futura — dejar vacío para deshabilitar)
# ──────────────────────────────────────
CRM_ENABLED=false
CRM_API_URL=
CRM_API_KEY=

# ──────────────────────────────────────
# EMAIL (opcional)
# ──────────────────────────────────────
MAIL_MAILER=log               # log (dev) | smtp | mailgun | ses
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@contactoconlanoticia.com
MAIL_FROM_NAME="Contacto con la Noticia"

