# ==============================================================================
# LYBERATE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANTE: Nunca registrar valores secretos reales en este archivo ni en Git.
# Copiar a .env y configurar las variables para el entorno local o de producción.
# ==============================================================================

# Application
APP_NAME=Lyberate
APP_ENV=development
APP_DEBUG=true
APP_KEY=generate-a-secure-32-character-key
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyberate_db
DB_USERNAME=lyberate_user
DB_PASSWORD=your_secure_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Multi-Tenant Context (Default Site: Contacto con la Noticia)
DEFAULT_TENANT_UUID=00000000-0000-0000-0000-000000000001
DEFAULT_SITE_UUID=00000000-0000-0000-0000-000000000002

# Session & Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Media & Storage
UPLOAD_MAX_FILESIZE=10M
UPLOAD_STORAGE_PATH=uploads

# Future Integrations (Phase 16 - EspoCRM)
# ESPOCRM_API_URL=
# ESPOCRM_API_KEY=
# ESPOCRM_HMAC_SECRET=

