# Lyberate / Contacto con la Noticia — Frontend Environment Config Template
# Options for VITE_DATA_MODE:
#   'mock' - Run standalone with local dev mock data (default)
#   'api'  - Connect to live backend REST API at /api/v1/
VITE_DATA_MODE=mock

# Canonical base URL for production SEO, JSON-LD, sitemaps, and Open Graph
VITE_SITE_URL=https://contactoconlanoticia.com
